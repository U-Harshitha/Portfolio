---
// One full-screen room per laptop part. The part's `room` decides what's inside.
import { readdirSync, existsSync } from 'node:fs';
import { render } from 'astro:content';
import site from '../../content/site.config';
import skills from '../../content/skills.json';
import photos from '../../content/photos.json';
import stickers from '../../content/stickers.json';
import { isTodo, todoText, isDark, hasResume } from '../lib/content';
import Video from './Video.astro';
import PartArt from './PartArt.astro';

const { part, data } = Astro.props;
// each local clip gets its own motion-study frames (made by `npm run media`)
const framesFor = (src?: string) => {
  if (!src) return [];
  const dir = `public${src}-frames`;
  return existsSync(dir) ? readdirSync(dir).filter((f) => f.endsWith('.jpg')).sort().map((f) => `${src}-frames/${f}`) : [];
};
const portrait = (photos as { portrait?: string }).portrait;
const { room, color } = part;
const withBody = async (list: any[]) => Promise.all(list.map(async (e) => ({ e, d: e.data, Content: (await render(e)).Content })));

const { Content: Intro } = await render(part.entry);
const experience = room === 'experience' ? await withBody(data.experience) : [];
const projects = room === 'projects' ? await withBody(data.projects) : [];
const reading = room === 'research' || room === 'battery' ? await withBody(data.reading) : [];
const events = room === 'events' ? await withBody(data.events) : [];
const videos = await withBody(data.videos.filter((v: any) => v.data.part === part.id));
const L = site.links;
const ext = { target: '_blank', rel: 'noopener' };
const mine = reading.filter((r) => r.d.kind === 'my-research');
const papers = reading.filter((r) => r.d.kind === 'paper');
const books = reading.filter((r) => r.d.kind === 'book');
const sources = reading.filter((r) => r.d.kind === 'source');
// dark rooms keep light text; everything else uses ink on the colour
const dark = isDark(color);
---
<article class="room-page" id={part.id} data-part={part.id} data-room={room} data-dark={dark ? 'true' : 'false'} style={`--c:${color}`} aria-labelledby={`${part.id}-title`} data-x={`content/parts/${part.id}.md → Room.astro room="${room}"`}>
  <header class="room-head">
    {/* the 3D part is the illustration; this drawing only shows without WebGL */}
    <figure class="room-art"><PartArt id={part.id} c={color} /></figure>
    <p class="room-part mono">{part.title}</p>
    <h2 id={`${part.id}-title`} class="room-title">{part.aspect}</h2>
    <div class="room-lede"><Intro /></div>
  </header>

  <div class="room-body">
    {room === 'intro' && (
      <>
        <section class="sec sec-intro">
          <div class="portrait">
            {portrait ? (
              <picture class="portrait-photo">
                <source type="image/avif" srcset={`${portrait}-480.avif 480w, ${portrait}-960.avif 960w`} sizes="(min-width: 900px) 280px, 70vw" />
                <source type="image/webp" srcset={`${portrait}-480.webp 480w, ${portrait}-960.webp 960w`} sizes="(min-width: 900px) 280px, 70vw" />
                <img src={`${portrait}-480.jpg`} alt="Harshitha Upadhyayula" width="480" height="600" loading="lazy" decoding="async" />
              </picture>
            ) : (
              <div class="portrait-frame" aria-hidden="true">
                <span class="monogram">HU</span>
                <span class="mono fine">photo loading… eventually</span>
              </div>
            )}
          </div>
          <div class="intro-facts">
            <h3>The short version</h3>
            <dl class="facts">
              <dt>Now</dt><dd>{site.now.text}</dd>
              <dt>Work</dt><dd>{site.role}</dd>
              <dt>Based in</dt><dd>Bengaluru, India</dd>
              <dt>Studied</dt><dd>{skills.education}</dd>
            </dl>
            <p class="actions"><a class="btn btn-primary" href="#cpu" data-open="cpu">See my work</a><a class="btn" href="#trackpad" data-open="trackpad">Say hi</a></p>
          </div>
        </section>
      </>
    )}

    {room === 'experience' && (
      <>
        <section class="sec">
          <h3>Where I've worked</h3>
          <ol class="timeline-list">
            {experience.map(({ d, Content }) => (
              <li>
                <p class="when mono">{d.start} – {d.end}</p>
                <p class="what"><strong>{d.role}</strong>, {d.org}</p>
                {d.team && <p class="team">{d.team}</p>}
                <div class="body"><Content /></div>
              </li>
            ))}
          </ol>
          <p class="fine">{skills.education}</p>
          <p class="actions">
            {hasResume && <a class="btn btn-primary" href={L.resume} download>Download resume (PDF)</a>}
            <a class="btn" href={L.linkedin} {...ext}>LinkedIn</a>
            {L.github && <a class="btn" href={L.github} {...ext}>GitHub</a>}
          </p>
        </section>
        <section class="sec">
          <h3>What I work with</h3>
          <dl class="skills">{skills.groups.map((g) => (<><dt>{g.title}</dt><dd>{g.items.join(', ')}</dd></>))}</dl>
        </section>
        <section class="sec">
          <h3>Along the way</h3>
          <ul class="wins">{skills.wins.map((w) => <li>{w}</li>)}</ul>
        </section>
      </>
    )}

    {room === 'projects' && (
      <section class="sec">
        <h3>Saved to disk</h3>
        <ul class="spec-list">
          {projects.map(({ d, Content }) => (
            <li>
              <details>
                <summary>
                  <span class="spec-title">{d.title}</span>
                  {d.status && <span class="tag">{d.status}</span>}
                  <span class="spec-summary">{d.summary}</span>
                  {d.stack.length > 0 && <span class="spec-stack mono">{d.stack.join(' / ')}</span>}
                </summary>
                <div class="body">
                  <Content />
                  {Object.entries(d.links).length > 0 && <p class="links">{Object.entries(d.links).map(([k, v]) => <a href={v as string} {...ext}>{k}</a>)}</p>}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    )}

    {room === 'content' && (
      <>
        <section class="sec">
          <h3>Latest</h3>
          <ul class="spec-list">
            {videos.map(({ d, Content }) => (
              <li class="media-row">
                <span class="tag">{d.platform}</span>
                <a class:list={['spec-title', isTodo(d.title) && 'todo-inline']} href={d.url} {...ext}>{todoText(d.title)}</a>
                <div class="body"><Content /></div>
              </li>
            ))}
          </ul>
        </section>
        <section class="sec">
          <h3>Follow along</h3>
          <div class="follow-grid">
            <a class="follow" href={L.linkedin} {...ext}>
              <strong>LinkedIn</strong>
              <span>Breakdowns of how systems work, in posts.</span>
              <span class="btn btn-primary">Follow on LinkedIn</span>
            </a>
            {L.youtube ? (
              <a class="follow" href={L.youtube} {...ext}><strong>YouTube</strong><span>Face-to-camera tech videos, and later, conversations.</span><span class="btn btn-primary">Subscribe</span></a>
            ) : (
              <div class="follow follow-soon"><strong>YouTube</strong><span>Face-to-camera tech videos, and later, podcasts with people who build things. Still rendering.</span><span class="btn" aria-disabled="true">Launching soon</span></div>
            )}
          </div>
        </section>
      </>
    )}

    {room === 'dance' && (
      <>
        <section class="sec">
          <h3>{videos.length > 1 ? 'Clips' : 'Clip'}</h3>
          {videos.map(({ d }) => {
            const frames = framesFor(d.src);
            return (
              <figure class="reel">
                <Video src={d.src} poster={d.poster} label={todoText(d.title)} />
                {frames.length > 0 && (
                  <div class="study" data-study aria-label="Motion study: frames from this clip. Drag across to scrub.">
                    <img class="study-big" src={frames[0]} alt="" width="200" height="356" loading="lazy" />
                    <div class="study-strip" role="slider" tabindex="0" aria-label="Scrub frames" aria-valuemin="1" aria-valuemax={frames.length} aria-valuenow="1">
                      {frames.map((f: string, k: number) => <img src={f} alt="" width="40" height="71" loading="lazy" data-k={k} />)}
                    </div>
                    <p class="scribble">motion study: {frames.length} frames. Drag across them.</p>
                  </div>
                )}
                <figcaption class:list={[isTodo(d.title) && 'todo-inline']}>{todoText(d.title)}</figcaption>
              </figure>
            );
          })}
        </section>
        <section class="sec">
          {L.instagram ? <a class="btn btn-primary" href={L.instagram} {...ext}>Follow the dance on Instagram</a> : <p class="scribble aside">more clips on Instagram soon.</p>}
        </section>
      </>
    )}

    {room === 'memories' && (
      <>
        <section class="sec">
          <h3>Cached frames</h3>
          <div class="photos" data-count={photos.photos.length}>
            {photos.photos.map((ph) => (
              <figure class="polaroid">
                <picture>
                  <source type="image/avif" srcset={`${ph.src}-480.avif 480w, ${ph.src}-960.avif 960w`} sizes="(min-width: 900px) 300px, 45vw" />
                  <source type="image/webp" srcset={`${ph.src}-480.webp 480w, ${ph.src}-960.webp 960w`} sizes="(min-width: 900px) 300px, 45vw" />
                  <img src={`${ph.src}-480.jpg`} alt={ph.alt} width="480" height="640" loading="lazy" decoding="async" />
                </picture>
                <figcaption class:list={['scribble', isTodo(ph.caption) && 'todo-inline']}>{todoText(ph.caption)}</figcaption>
              </figure>
            ))}
          </div>
        </section>
        <section class="sec">
          <h3>On rotation</h3>
          <dl class="skills">
            {photos.rotation.map((r) => (<><dt>{r.label}</dt><dd>{r.value}</dd></>))}
          </dl>
          <p class="scribble aside">psst: the stickers on the lid are clickable too.</p>
        </section>
      </>
    )}

    {room === 'battery' && (
      <>
        <section class="sec">
          <h3>Books</h3>
          {books.map(({ d, Content }) => (
            <article class="note">
              <h4 class:list={[isTodo(d.title) && 'todo-inline']}>{todoText(d.title)}</h4>
              {d.authors && <p class="meta">{todoText(d.authors)}</p>}
              <div class="body"><Content /></div>
            </article>
          ))}
        </section>
        <section class="sec">
          <h3>What keeps me going</h3>
          {sources.map(({ d, Content }) => (
            <article class="note">
              <h4 class:list={[isTodo(d.title) && 'todo-inline']}>{todoText(d.title)}</h4>
              <div class="body"><Content /></div>
            </article>
          ))}
        </section>
      </>
    )}

    {room === 'research' && (
      <>
        <section class="sec">
          <h3>My research</h3>
          {mine.map(({ d, Content }) => (
            <article class="note">
              <h4>{d.title}</h4>
              {d.authors && <p class:list={['meta mono', isTodo(d.authors) && 'todo-inline']}>{todoText(d.authors)}</p>}
              <div class="body"><Content /></div>
            </article>
          ))}
        </section>
        <section class="sec">
          <h3>Papers I've read</h3>
          <p class="scribble aside">my takeaways, not summaries. Argue with me.</p>
          {papers.map(({ d, Content }) => (
            <article class="note">
              {d.read && <p class="kind mono">read {d.read}</p>}
              <h4 class:list={[isTodo(d.title) && 'todo-inline']}>{d.link ? <a href={d.link} {...ext}>{todoText(d.title)}</a> : todoText(d.title)}</h4>
              {d.authors && <p class="meta">{todoText(d.authors)}{d.year && `, ${d.year}`}</p>}
              <div class="body"><Content /></div>
            </article>
          ))}
        </section>
      </>
    )}

    {room === 'events' && (
      <section class="sec">
        <h3>Rooms I've helped fill</h3>
        <ol class="timeline-list">
          {events.map(({ d, Content }) => (
            <li>
              <p class="what"><strong>{d.title}</strong></p>
              <p class="team">{d.role}{d.when && !isTodo(d.when) && `, ${d.when}`}</p>
              <div class="body"><Content /></div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {room === 'contact' && (
      <section class="sec contact">
        <h3>Reach me</h3>
        <ul class="contact-list">
          <li><a class="contact-link" href={L.linkedin} {...ext}><span>LinkedIn</span><span class="mono">/in/harshitha-upadhyayula</span></a></li>
          {L.github && <li><a class="contact-link" href={L.github} {...ext}><span>GitHub</span><span class="mono">U-Harshitha</span></a></li>}
          {L.email && <li><a class="contact-link" href={`mailto:${L.email}`}><span>Email</span><span class="mono">{L.email}</span></a></li>}
          {L.instagram && <li><a class="contact-link" href={L.instagram} {...ext}><span>Instagram</span><span class="mono">dance</span></a></li>}
          {hasResume && <li><a class="contact-link" href={L.resume} download><span>Resume</span><span class="mono">PDF</span></a></li>}
        </ul>
        <p class="scribble aside">stickers on the lid: {stickers.stickers.length}. Collect them all.</p>
      </section>
    )}
  </div>

  <footer class="room-foot">
    <button class="next-part" type="button" data-next>
      <span class="scribble">next part</span>
      <span class="next-name">…</span>
    </button>
  </footer>
</article>
