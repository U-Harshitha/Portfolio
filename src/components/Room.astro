---
// One room per laptop part. The part's `room` decides what's inside.
import { render } from 'astro:content';
import site from '../../content/site.config';
import skills from '../../content/skills.json';
import photos from '../../content/photos.json';
import { isTodo, todoText, isDark, hasResume } from '../lib/content';
import Video from './Video.astro';
import PartArt from './PartArt.astro';
import Pic from './Pic.astro';

const { part, data } = Astro.props;
const { room, color } = part;
const names: string[] = part.names?.length ? part.names : [part.aspect];
const nameIdx: number = Math.max(0, Math.min(names.length - 1, (part.name ?? 1) - 1));

const hash = (s: string) => { let h = 2166136261; for (const ch of s) h = Math.imul(h ^ ch.charCodeAt(0), 16777619); return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7); };
const portrait = (photos as { portrait?: string }).portrait;
const withBody = async (list: any[]) => Promise.all(list.map(async (e) => ({ e, d: e.data, Content: (await render(e)).Content })));

const { Content: Intro } = await render(part.entry);
const experience = room === 'experience' ? await withBody(data.experience) : [];
const projects = room === 'projects' ? await withBody(data.projects) : [];
const reading = room === 'research' || room === 'battery' ? await withBody(data.reading) : [];
const events = room === 'events' ? await withBody(data.events) : [];
const videos = await withBody(data.videos.filter((v: any) => v.data.part === part.id));
const L = site.links;
const ext = { target: '_blank', rel: 'noopener' };
const mine = reading.filter((r) => r.d.kind === 'my-research');
const papers = reading.filter((r) => r.d.kind === 'paper');
const charged = reading.filter((r) => r.d.kind === 'book' || r.d.kind === 'source');
const dark = isDark(color);
const facts: [string, string][] = [
  ['now', site.now.text],
  ['work', site.role],
  ['based', 'Bengaluru, India'],
  ['studied', skills.education],
];
const contacts = [
  { label: 'LinkedIn', detail: '/in/harshitha-upadhyayula', href: L.linkedin, key: 'L', ext: true },
  L.github && { label: 'GitHub', detail: 'U-Harshitha', href: L.github, key: 'G', ext: true },
  L.email && { label: 'Email', detail: L.email, href: `mailto:${L.email}`, key: 'E', ext: false },
  L.instagram && { label: 'Instagram', detail: 'dance', href: L.instagram, key: 'I', ext: true },
  hasResume && { label: 'Resume', detail: 'PDF', href: L.resume, key: 'R', ext: false, download: true },
].filter(Boolean) as { label: string; detail: string; href: string; key: string; ext: boolean; download?: boolean }[];
const isCurrent = (end: string) => /present/i.test(end);
const chat: [string, string][] = [
  ['them', 'hi! who are you?'],
  ['me', "I'm Harshitha. I work on networking for Google Cloud VMware Engine."],
  ['them', 'what do you do when you are not working?'],
  ['me', 'Dance, read papers, organise events, and build small tools that run my own days.'],
  ['them', "what's with the laptop?"],
  ['me', "It's me, taken apart. Open any part and it clicks back in when you're done."],
];
---
<article
  class="room-page" id={part.id} data-part={part.id} data-room={room} data-dark={dark ? 'true' : 'false'}
  style={`--c:${color}`} aria-labelledby={`${part.id}-title`} data-x={`content/parts/${part.id}.md → Room.astro room="${room}"`}
>
  <header class="room-head">
    <figure class="room-art"><PartArt id={part.id} c={color} /></figure>
    <p class="room-part mono">{part.title}</p>
    <h2 id={`${part.id}-title`} class="room-title">{names[nameIdx]}</h2>
    <div class="room-lede"><Intro /></div>
  </header>

  <div class="room-body">

    {/* ═════════════ SCREEN: intro — a profile card, then a short conversation ═════════════ */}
    {room === 'intro' && (
      <>
        <section class="sec">
          <div class="profile-card">
            <div class="boot-photo">{portrait ? <Pic src={portrait} alt="Harshitha Upadhyayula" /> : <span class="monogram">HU</span>}</div>
            <div>
              <p class="profile-name">Harshitha Upadhyayula</p>
              <dl class="facts">{facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
            </div>
          </div>
        </section>
        <section class="sec">
          <h3>A quick conversation</h3>
          <div class="chat">
            {chat.map(([who, text]) => (
              <div class:list={['bubble-row', who]}>
                {who === 'me' && <span class="chat-avatar" aria-hidden="true">{portrait ? <Pic src={portrait} alt="" sizes="40px" /> : 'H'}</span>}
                <p class="bubble">{text}</p>
              </div>
            ))}
            <div class="bubble-row me"><span class="chat-avatar" aria-hidden="true">H</span><p class="bubble typing" aria-label="typing"><i></i><i></i><i></i></p></div>
          </div>
        </section>
        <p class="actions"><a class="btn btn-primary" href="#cpu" data-open="cpu">See my work</a><a class="btn" href="#trackpad" data-open="trackpad">Say hi</a></p>
      </>
    )}

    {/* ═════════════ CPU: experience — as a git log ═════════════ */}
    {room === 'experience' && (
      <>
        <section class="sec">
          <div class="gitlog mono">
            <p class="gitlog-cmd"><span class="t-prompt">$</span> git log --career</p>
            {experience.map(({ d, Content }) => (
              <div class="commit">
                <p class="commit-line"><span class="commit-hash">commit {hash(d.org + d.start)}</span>{isCurrent(d.end) && <span class="commit-ref">(HEAD → main)</span>}</p>
                <p class="commit-meta">Date: {d.start} – {d.end}</p>
                <p class="commit-subject">{d.role} @ {d.org}</p>
                {d.team && <p class="commit-team">{d.team}</p>}
                <div class="commit-body body"><Content /></div>
              </div>
            ))}
          </div>
        </section>
        <section class="sec">
          <h3>Dependencies</h3>
          <div class="deps mono">{skills.groups.map((g) => (<p><span class="dep-group">"{g.title}"</span>: [{g.items.map((it, i) => <><span class="dep">"{it}"</span>{i < g.items.length - 1 ? ', ' : ''}</>)}]</p>))}</div>
        </section>
        <section class="sec">
          <h3>Tags</h3>
          <ul class="wins">{skills.wins.map((w, i) => <li><span class="win-tag mono">v{i + 1}.0</span>{w}</li>)}</ul>
        </section>
        <p class="actions">
          {hasResume && <a class="btn btn-primary" href={L.resume} download>Download resume (PDF)</a>}
          <a class="btn" href={L.linkedin} {...ext}>LinkedIn</a>
          {L.github && <a class="btn" href={L.github} {...ext}>GitHub</a>}
        </p>
      </>
    )}

{/* ═════════════ SSD: projects, as a file explorer ═════════════ */}
    {room === 'projects' && (
      <section class="sec">
        <div class="finder">
          <div class="finder-bar"><i></i><i></i><i></i><span class="mono">projects</span></div>
          <div class="finder-cols mono"><span>Name</span><span>Kind</span><span>Status</span></div>
          {projects.map(({ d, Content }) => (
            <details class="finder-row">
              <summary>
                <span class="finder-name"><svg viewBox="0 0 20 16" aria-hidden="true"><path d="M1 3a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2z" /></svg>{d.title}</span>
                <span class="finder-kind mono">{d.stack[0] ?? 'folder'}</span>
                <span class="finder-status mono">{d.status ?? 'shipped'}</span>
              </summary>
              <div class="finder-preview">
                <p class="mono finder-file">README.md</p>
                <p class="spec-summary">{d.summary}</p>
                <div class="body"><Content /></div>
                {d.stack.length > 0 && <p class="spec-stack mono">{d.stack.join(' · ')}</p>}
                {Object.entries(d.links).length > 0 && <p class="links">{Object.entries(d.links).map(([k, v]) => <a href={v as string} {...ext}>{k}</a>)}</p>}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* ═════════════ GPU: content, as a render queue ═════════════ */}
    {room === 'content' && (
      <section class="sec">
        <h3>Render queue</h3>
        <ol class="queue">
          <li class="job done"><span class="job-state mono">rendered</span><a href={L.linkedin} {...ext}><strong>LinkedIn posts</strong></a><span class="job-desc">Breakdowns of how systems work, ongoing.</span></li>
          {L.youtube
            ? <li class="job done"><span class="job-state mono">rendered</span><a href={L.youtube} {...ext}><strong>YouTube channel</strong></a><span class="job-desc">Face-to-camera tech videos.</span></li>
            : <li class="job running"><span class="job-state mono">rendering</span><strong>YouTube channel</strong><span class="job-desc">Face-to-camera tech videos.</span><span class="job-bar" aria-hidden="true"></span></li>}
          <li class="job queued"><span class="job-state mono">queued</span><strong>Podcast</strong><span class="job-desc">Conversations with people who build things.</span></li>
        </ol>
        {videos.length > 0 && (
          <>
            <h3 class="sp-top">Latest output</h3>
            <ul class="spec-list">
              {videos.map(({ d, Content }) => (
                <li class="media-row"><span class="tag">{d.platform}</span><a class:list={['spec-title', isTodo(d.title) && 'todo-inline']} href={d.url} {...ext}>{todoText(d.title)}</a><div class="body"><Content /></div></li>
              ))}
            </ul>
          </>
        )}
        <p class="actions"><a class="btn btn-primary" href={L.linkedin} {...ext}>Follow on LinkedIn</a></p>
      </section>
    )}

    {/* ═════════════ SPEAKERS: dance — each clip as a reel on a phone ═════════════ */}
    {room === 'dance' && (
      <>
        <section class="sec reels">
          {videos.map(({ d }) => {
            const title = todoText(d.title);
            return (
              <div class="reel-phone">
                <div class="reel-screen">
                  <Video src={d.src} poster={d.poster} label={title} />
                  <div class="reel-overlay">
                    <p class="reel-user"><span class="reel-avatar" aria-hidden="true">H</span> harshitha · dance</p>
                    <p class="reel-caption">{title}</p>
                  </div>
                  <div class="reel-side" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 5 6.4 5c2 0 3.4 1.1 4.1 2.3h3c.7-1.2 2.1-2.3 4.1-2.3C21 5 23.1 8.4 21.6 11.8 19.5 16.4 12 21 12 21z" /></svg>
                    <svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4z" /></svg>
                    <svg viewBox="0 0 24 24"><path d="M21 4L10 14M21 4l-7 17-3-8-8-3z" /></svg>
                  </div>
                </div>
              </div>
            );
          })}
        </section>
        <section class="sec">
          {L.instagram ? <a class="btn btn-primary" href={L.instagram} {...ext}>Follow the dance on Instagram</a> : <p class="aside">More clips on Instagram soon.</p>}
        </section>
      </>
    )}

{/* ═════════════ RAM: memories, as polaroids ═════════════ */}
    {room === 'memories' && (
      <>
        <section class="sec">
          <h3>Cached frames</h3>
          <div class="photos" data-count={photos.photos.length}>
            {photos.photos.map((ph) => (<figure class="polaroid"><Pic src={ph.src} alt={ph.alt} /><figcaption class="scribble">{todoText(ph.caption)}</figcaption></figure>))}
          </div>
        </section>
        <section class="sec">
          <h3>On rotation</h3>
          <dl class="skills">{photos.rotation.map((r) => (<><dt>{r.label}</dt><dd>{r.value}</dd></>))}</dl>
        </section>
        <p class="aside">The stickers on the lid open too; each one is a place or a habit.</p>
      </>
    )}

    {/* ═════════════ BATTERY: books + motivation, as pull quotes ═════════════ */}
    {room === 'battery' && (
      <section class="sec">
        {charged.map(({ d, Content }) => (
          <blockquote class="pull"><div class="pull-text"><Content /></div><footer><span class="pull-src">{todoText(d.title)}</span>{d.authors && <span class="mono"> · {todoText(d.authors)}</span>}</footer></blockquote>
        ))}
      </section>
    )}

    {/* ═════════════ KEYBOARD: papers + research, typewritten ═════════════ */}
    {room === 'research' && (
      <>
        <section class="sec">
          <h3>Typed by me</h3>
          {mine.map(({ d, Content }) => (
            <article class="paper"><p class="kind mono">my research</p><h4>{d.title}</h4>{d.authors && <p class="meta">{todoText(d.authors)}</p>}<div class="body"><Content /></div></article>
          ))}
        </section>
        <section class="sec">
          <h3>Notes from the margins</h3>
          {papers.map(({ d, Content }) => (
            <article class="paper">
              <p class="kind mono">{d.year ? `paper · ${d.year}` : 'paper'}</p>
              <h4 class:list={[isTodo(d.title) && 'todo-inline']}>{d.link ? <a href={d.link} {...ext}>{todoText(d.title)}</a> : todoText(d.title)}</h4>
              {d.authors && <p class="meta">{todoText(d.authors)}</p>}
              <div class="body"><Content /></div>
            </article>
          ))}
        </section>
      </>
    )}

    {/* ═════════════ WI-FI: events, as tickets ═════════════ */}
    {room === 'events' && (
      <section class="sec">
        <div class="tickets">
          {events.map(({ d, Content }, i) => (
            <article class="ticket">
              <div class="ticket-main"><p class="mono ticket-org">{d.org ?? 'event'}</p><h4>{d.title}</h4><p class="ticket-role">{d.role}</p><div class="body"><Content /></div></div>
              <div class="ticket-stub mono" aria-hidden="true"><span>admit one</span><b>No. {String(i + 1).padStart(3, '0')}</b></div>
            </article>
          ))}
        </div>
      </section>
    )}

    {/* ═════════════ TRACKPAD: contact, as a command bar ═════════════ */}
    {room === 'contact' && (
      <>
        <section class="sec">
          <div class="cmdk">
            <div class="cmdk-input"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="M14 14l4 4" /></svg><span>Reach Harshitha…</span><kbd class="mono">⌘K</kbd></div>
            <p class="cmdk-group mono">actions</p>
            {contacts.map((c) => (
              <a class="cmdk-row" href={c.href} {...(c.ext ? ext : {})} download={c.download ? '' : undefined}><span class="cmdk-icon mono" aria-hidden="true">{c.key}</span><span class="cmdk-label">Open {c.label}</span><span class="cmdk-detail mono">{c.detail}</span><kbd class="mono">↵</kbd></a>
            ))}
          </div>
        </section>
      </>
    )}
  </div>

  <footer class="room-foot">
    <button class="next-part" type="button" data-next>
      <span class="next-label">Next component</span>
      <span class="next-name">…</span>
    </button>
  </footer>
</article>
